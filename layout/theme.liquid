<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{{ settings.color_cream }}"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'design-v2.css' | asset_url | stylesheet_tag }}<style>:root{--cream:{{ settings.color_cream }};--ink:{{ settings.color_ink }};--rust:{{ settings.color_rust }};--gold:{{ settings.color_gold }};--taupe:{{ settings.color_taupe }};}</style><script src="{{ 'theme.js' | asset_url }}" defer></script>{{ 'story-v3.css' | asset_url | stylesheet_tag }}<script src="{{ 'reveal-v3.js' | asset_url }}" defer></script></head><body><a href="#MainContent" class="skip-link">Skip to content</a>{% section 'header' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% section 'newsletter' %}{% section 'footer' %}{% render 'avenue-dialogs' %}<script src="{{ 'commerce-v2.js' | asset_url }}" defer></script></body></html>
