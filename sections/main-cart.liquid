<section class="page-intro"><div class="wrap"><span class="eyebrow">Your daily ritual, coming home</span><h1>Your bag.</h1><p>Good things start with good coffee.</p></div></section><section class="section wrap">{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}{% else %}<span>☕</span>{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p><small>{{ item.variant.title | escape }}</small></p>{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p><small>{{ property.first | escape }}: {{ property.last | escape }}</small></p>{% endif %}{% endfor %}<a class="text-link" href="{{ item.url_to_remove }}">Remove</a></div><div><label class="sr-only" for="Qty-{{ forloop.index }}">Quantity for {{ item.product.title | escape }}</label><input id="Qty-{{ forloop.index }}" name="updates[]" value="{{ item.quantity }}" type="number" min="0" step="1"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cart-total">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<h3>Subtotal {{ cart.total_price | money }}</h3><p>Taxes and shipping calculated at checkout.</p><div class="actions"><button class="btn outline" name="update" type="submit">Update bag</button><button class="btn" name="checkout" type="submit">Checkout ↗</button></div></div></form>{% else %}<div class="empty"><h2>A little room for something good.</h2><p>Your bag is currently empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explore the coffee ↗</a></div>{% endif %}</section>
{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
