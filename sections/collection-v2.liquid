<section class="section-v2 wide" id="coffee-collection"><div class="center-heading"><span class="kicker">Find your new favorite</span><h2>Your next daily ritual.</h2><p>A little discovery. A lot to look forward to.</p></div>{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}<div class="coffee-grid" style="margin-top:35px">{% for product in section.settings.collection.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}</div>{% elsif section.settings.show_demo %}<p class="demo-note" style="margin-top:25px">Glozin sample products · $25.99 / 12 oz is an illustrative price · Ordering disabled</p><div class="coffee-grid"><article class="coffee-card" data-coffee-card data-id="1" data-name="Sulladjah Ethiopia Abana Coffee" data-category="Ethiopia" data-price="25.99"><div class="coffee-media"><button class="image-view" data-quick-view="1" aria-label="View Sulladjah Ethiopia Abana Coffee"><img src="{{ 'demo-coffee-1.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt="Sulladjah Ethiopia Abana Coffee, Glozin demo product"><img class="hover-photo" src="{{ 'demo-coffee-1-alt.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt=""></button><span class="product-badge">Demo product</span><button class="save-button" data-save="1" aria-pressed="false" aria-label="Save Sulladjah Ethiopia Abana Coffee"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 5.5c-2.3-2.3-6-1.2-8.5 1.2C9.5 4.3 5.8 3.2 3.5 5.5-1 10 7 17 12 21c5-4 13-11 8.5-15.5Z"/></svg></button><button class="quick-view" data-quick-view="1">Quick view <span>+</span></button></div><div class="coffee-meta"><span>Ethiopia · Whole bean</span><button class="product-name" data-quick-view="1">Sulladjah Ethiopia Abana Coffee</button><div class="price-line"><strong>$25.99</strong><span>12 oz / 340 g</span><button class="mini-add" data-demo-add="1" aria-label="Add Sulladjah Ethiopia Abana Coffee to demo bag">+</button></div></div></article><article class="coffee-card" data-coffee-card data-id="2" data-name="Huehuetenango Arabica Coffee" data-category="Guatemala" data-price="25.99"><div class="coffee-media"><button class="image-view" data-quick-view="2" aria-label="View Huehuetenango Arabica Coffee"><img src="{{ 'demo-coffee-2.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt="Huehuetenango Arabica Coffee, Glozin demo product"><img class="hover-photo" src="{{ 'demo-coffee-2-alt.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt=""></button><span class="product-badge">Demo product</span><button class="save-button" data-save="2" aria-pressed="false" aria-label="Save Huehuetenango Arabica Coffee"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 5.5c-2.3-2.3-6-1.2-8.5 1.2C9.5 4.3 5.8 3.2 3.5 5.5-1 10 7 17 12 21c5-4 13-11 8.5-15.5Z"/></svg></button><button class="quick-view" data-quick-view="2">Quick view <span>+</span></button></div><div class="coffee-meta"><span>Guatemala · Whole bean</span><button class="product-name" data-quick-view="2">Huehuetenango Arabica Coffee</button><div class="price-line"><strong>$25.99</strong><span>12 oz / 340 g</span><button class="mini-add" data-demo-add="2" aria-label="Add Huehuetenango Arabica Coffee to demo bag">+</button></div></div></article><article class="coffee-card" data-coffee-card data-id="3" data-name="Condor Tolima Colombia Coffee" data-category="Colombia" data-price="25.99"><div class="coffee-media"><button class="image-view" data-quick-view="3" aria-label="View Condor Tolima Colombia Coffee"><img src="{{ 'demo-coffee-3.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt="Condor Tolima Colombia Coffee, Glozin demo product"><img class="hover-photo" src="{{ 'demo-coffee-3-alt.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt=""></button><span class="product-badge">Demo product</span><button class="save-button" data-save="3" aria-pressed="false" aria-label="Save Condor Tolima Colombia Coffee"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 5.5c-2.3-2.3-6-1.2-8.5 1.2C9.5 4.3 5.8 3.2 3.5 5.5-1 10 7 17 12 21c5-4 13-11 8.5-15.5Z"/></svg></button><button class="quick-view" data-quick-view="3">Quick view <span>+</span></button></div><div class="coffee-meta"><span>Colombia · Whole bean</span><button class="product-name" data-quick-view="3">Condor Tolima Colombia Coffee</button><div class="price-line"><strong>$25.99</strong><span>12 oz / 340 g</span><button class="mini-add" data-demo-add="3" aria-label="Add Condor Tolima Colombia Coffee to demo bag">+</button></div></div></article><article class="coffee-card" data-coffee-card data-id="7" data-name="Floresta Espresso Blend Coffee" data-category="Espresso" data-price="25.99"><div class="coffee-media"><button class="image-view" data-quick-view="7" aria-label="View Floresta Espresso Blend Coffee"><img src="{{ 'demo-coffee-7.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt="Floresta Espresso Blend Coffee, Glozin demo product"><img class="hover-photo" src="{{ 'demo-coffee-7-alt.jpg' | asset_url }}" width="900" height="900" loading="lazy" alt=""></button><span class="product-badge">Demo product</span><button class="save-button" data-save="7" aria-pressed="false" aria-label="Save Floresta Espresso Blend Coffee"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 5.5c-2.3-2.3-6-1.2-8.5 1.2C9.5 4.3 5.8 3.2 3.5 5.5-1 10 7 17 12 21c5-4 13-11 8.5-15.5Z"/></svg></button><button class="quick-view" data-quick-view="7">Quick view <span>+</span></button></div><div class="coffee-meta"><span>Espresso · Whole bean</span><button class="product-name" data-quick-view="7">Floresta Espresso Blend Coffee</button><div class="price-line"><strong>$25.99</strong><span>12 oz / 340 g</span><button class="mini-add" data-demo-add="7" aria-label="Add Floresta Espresso Blend Coffee to demo bag">+</button></div></div></article></div>{% else %}<p class="empty-results">Our first coffee collection is coming soon.</p>{% endif %}<div class="center-action"><a class="button-v2 outline-v2" href="{{ routes.all_products_collection_url }}">Shop all coffee →</a></div></section>
{% schema %}
{
  "name": "Collection V2",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured coffee collection"
