</form>{% paginate collection.products by 12 %}<p class="demo-note" style="text-align:left;margin-top:25px">{{ collection.products_count }} coffees</p><div class="coffee-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No coffees match these filters.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>{% endif %}
{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_demo",
      "label": "Show sample collection when empty",
      "default": true
    }
  ]
}
{% endschema %}
