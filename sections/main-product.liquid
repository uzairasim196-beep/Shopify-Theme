<section class="section wrap"><div class="product-detail"><div class="product-gallery">{% if product.images.size > 0 %}{% for image in product.images %}{{ image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', loading: 'lazy' }}{% endfor %}{% else %}<div class="product-art"><div class="bag" aria-label="Illustrative packaging concept"><div class="bag-label"><img src="{{ 'brand-logo.jpg' | asset_url }}" alt="75th Avenue Coffee" width="149" height="149" loading="lazy"><strong>Whole-bean coffee</strong><p>ROASTED IN TEXAS · 12 OZ</p></div></div><span class="concept">Packaging concept · product photography to come</span></div>{% endif %}</div><div><span class="eyebrow">75th Avenue Coffee · Roasted in Texas</span><h1>{{ product.title | escape }}</h1><p>{{ product.price | money }}{% if product.price_varies %} and up{% endif %}</p><div>{{ product.description }}</div>{% form 'product', product, id: 'ProductForm' %}<div class="field"><label for="Variant">Choose your coffee</label><select name="id" id="Variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select></div><div class="field"><label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" value="1" min="1" step="1"></div><button class="btn" name="add" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag ↗{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% endform %}{% if shop.shipping_policy.body != blank %}<p><small><a href="{{ shop.shipping_policy.url }}">Shipping</a> calculated at checkout.</small></p>{% endif %}<div class="faq"><details><summary>Make it your ritual</summary><p>Start with freshly ground whole beans and adjust your recipe to taste. <a href="{{ routes.root_url }}#coffee-collection" class="text-link">Explore the collection</a> for a brewing starting point.</p></details></div></div></div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
