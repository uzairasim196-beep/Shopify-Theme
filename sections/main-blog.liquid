<section class="page-intro"><div class="wrap"><span class="eyebrow">Notes from the Avenue</span><h1>{{ blog.title | escape }}</h1><p>Coffee, culture, and connection in the Southwest.</p></div></section><section class="section wrap">{% paginate blog.articles by 9 %}<div class="blog-grid">{% for article in blog.articles %}<article class="blog-card">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}<span class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</span><h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p><a class="text-link" href="{{ article.url }}">Read more ↗</a></article>{% else %}<p>Our first stories are on their way.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}
{
  "name": "Main Blog",
  "settings": []
}
{% endschema %}
