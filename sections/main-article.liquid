<section class="page-intro"><div class="wrap"><span class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</span><h1>{{ article.title | escape }}</h1><p></p></div></section><article class="section wrap"><div class="prose">{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy' }}{% endif %}{{ article.content }}<a class="text-link" href="{{ blog.url }}">← Back to {{ blog.title | escape }}</a></div></article><script type="application/ld+json">{{ article | structured_data }}</script>
{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}
