<article class="coffee-card actual-card"><div class="coffee-media"><a class="image-view" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 500, 700, 900' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a>{% unless product.available %}<span class="product-badge">Sold out</span>{% endunless %}</div><div class="coffee-meta"><span>{{ product.type | escape }}</span><a class="product-name" href="{{ product.url }}">{{ product.title | escape }}</a><div class="price-line"><strong>{{ product.price | money }}{% if product.price_varies %}+{% endif %}</strong><a class="mini-add" href="{{ product.url }}">View →</a></div></div></article>
